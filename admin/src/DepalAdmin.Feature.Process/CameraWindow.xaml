<Window x:Class="DepalAdmin.Feature.Process.CameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DepalAdmin.Feature.Process"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:LiveCamera}"
        Title="{Binding Title, StringFormat=카메라 — {0}}"
        Width="960" Height="600" MinWidth="480" MinHeight="320"
        Background="#15171A" WindowStartupLocation="CenterOwner">
    <!-- 담당: 김초아 — 카메라 1대 크게 보기 (다른 탭으로 가도 이 창은 계속 떠 있음, 두 번째 모니터로 옮겨도 됨) -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#22262B" Padding="12,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="#C9CED6" FontSize="14" VerticalAlignment="Center">
                    <Run Text="{Binding StatusText, Mode=OneWay}"
                         Foreground="{Binding StatusKey, Converter={StaticResource StatusToBrush}}"/>
                    <Run Text="  "/>
                    <Run Text="{Binding FpsText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#22262B" Padding="12,6">
            <TextBlock Text="{Binding Url}" Foreground="#8B929C" FontSize="12"/>
        </Border>
        <Grid>
            <!-- 글자를 뒤에 두고 영상을 위에 겹침: 영상이 오면 글자가 가려짐 -->
            <TextBlock Text="영상 없음" Foreground="#8B929C" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Image Source="{Binding Frame}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>
    </DockPanel>
</Window>
