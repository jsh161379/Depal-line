<UserControl x:Class="DepalAdmin.Feature.Process.ProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:DepalAdmin.Feature.Process"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:ProcessViewModel}"
             d:DesignWidth="1200" d:DesignHeight="680">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0 공정 흐름 -->
                <RowDefinition Height="Auto"/>  <!-- 1 카메라(2줄 차지) | 분류 개수 | 라인 조작 -->
                <RowDefinition Height="Auto"/>  <!-- 2 카메라 계속      | AGV -->
                <RowDefinition Height="Auto"/>  <!-- 3 팔레트 -->
                <RowDefinition Height="Auto"/>  <!-- 4 환경 센서 -->
                <RowDefinition Height="Auto"/>  <!-- 5 서버 메시지 -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ── 공정 흐름: 퍽이 있는 공정을 진하게 (여러 칸 동시 가능) ── -->
            <HeaderedContentControl Grid.ColumnSpan="5" Style="{StaticResource Section}" Margin="0,0,0,10">
                <HeaderedContentControl.Header>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" FontWeight="Normal" Foreground="{StaticResource Brush.SubText}"
                                   VerticalAlignment="Center">
                            <Run Text="회차"/>
                            <Run Text="{Binding RunId, Mode=OneWay}" FontFamily="{StaticResource Font.Readout}"/>
                        </TextBlock>
                        <!-- 환경 센서 수치 (그래프는 맨 아래 환경 센서 칸). 기준 넘으면 호박색, 가스 감지면 빨강 -->
                        <TextBlock DockPanel.Dock="Right" FontWeight="Normal" FontSize="14" Margin="0,0,20,0" VerticalAlignment="Center">
                            <Run Text="온도" Foreground="{StaticResource Brush.SubText}"/>
                            <Run Text="{Binding Env.Temperature.CurrentText, Mode=OneWay}" FontWeight="SemiBold" FontFamily="{StaticResource Font.Readout}"
                                 Foreground="{Binding Env.Temperature.Status, Converter={StaticResource StatusToBrush}}"/><Run Text="℃"/>
                            <Run Text="   습도" Foreground="{StaticResource Brush.SubText}"/>
                            <Run Text="{Binding Env.Humidity.CurrentText, Mode=OneWay}" FontWeight="SemiBold" FontFamily="{StaticResource Font.Readout}"
                                 Foreground="{Binding Env.Humidity.Status, Converter={StaticResource StatusToBrush}}"/><Run Text="%"/>
                            <Run Text="   가스" Foreground="{StaticResource Brush.SubText}"/>
                            <Run Text="{Binding Env.GasStatusText, Mode=OneWay}" FontWeight="SemiBold"
                                 Foreground="{Binding Env.GasStatus, Converter={StaticResource StatusToBrush}}"/>
                        </TextBlock>
                        <TextBlock Text="공정 흐름" VerticalAlignment="Center"/>
                    </DockPanel>
                </HeaderedContentControl.Header>

                <ItemsControl ItemsSource="{Binding Stations}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Box" Height="70" BorderThickness="1" Padding="10,8"
                                        Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Rule}">
                                    <StackPanel VerticalAlignment="Center">
                                        <DockPanel>
                                            <!-- 이 공정에 있는 퍽 번호 (검사·측정·분류만) -->
                                            <TextBlock x:Name="PuckText" DockPanel.Dock="Right" Text="{Binding Pucks}" FontSize="13"
                                                       FontFamily="{StaticResource Font.Readout}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brush.SubText}"/>
                                            <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <TextBlock x:Name="Sub" Text="{Binding Sub}" FontSize="11.5"
                                                   Foreground="{StaticResource Brush.SubText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- 화살표 (마지막 칸은 없음) -->
                                <Path x:Name="Arrow" Grid.Column="1" Data="M 3,0 L 13,8 L 3,16 Z" VerticalAlignment="Center"
                                      HorizontalAlignment="Center" Fill="{StaticResource Brush.Rule}"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Frame}"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="#15171A"/>
                                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource Brush.FrameText}"/>
                                    <Setter TargetName="Sub" Property="Foreground" Value="{StaticResource Brush.FrameSub}"/>
                                    <Setter TargetName="PuckText" Property="Foreground" Value="{StaticResource Brush.FrameText}"/>
                                    <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource Brush.Frame}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </HeaderedContentControl>

            <!-- ── 카메라 실시간 (김초아): 누르면 큰 창. 주소는 실행 폴더 cameras.json ── -->
            <HeaderedContentControl Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource Section}" Margin="0,0,0,10">
                <HeaderedContentControl.Header>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="누르면 크게 보기" FontWeight="Normal"
                                   Foreground="{StaticResource Brush.SubText}" VerticalAlignment="Center"/>
                        <TextBlock Text="카메라"/>
                    </DockPanel>
                </HeaderedContentControl.Header>
                <ItemsControl ItemsSource="{Binding Cameras}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:LiveCamera}">
                            <Button Margin="4" Padding="0" Cursor="Hand" Focusable="False" VerticalAlignment="Top"
                                    Background="Transparent" BorderBrush="{StaticResource Brush.Rule}" BorderThickness="1"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Command="{Binding DataContext.OpenCameraCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Background="{StaticResource Brush.Field}" Margin="0">
                                        <TextBlock DockPanel.Dock="Right" Margin="0,4,8,4" FontSize="12" VerticalAlignment="Center">
                                            <Run Text="{Binding StatusText, Mode=OneWay}" FontWeight="SemiBold"
                                                 Foreground="{Binding StatusKey, Converter={StaticResource StatusToBrush}}"/>
                                            <Run Text="{Binding FpsText, Mode=OneWay}" Foreground="{StaticResource Brush.SubText}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Title}" Margin="8,4" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <Grid Height="210" Background="#15171A">
                                        <TextBlock Text="영상 없음" Foreground="#8B929C" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding Frame}" Stretch="Uniform"/>
                                    </Grid>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </HeaderedContentControl>

            <!-- ── 팔레트 2×5 ── -->
            <HeaderedContentControl Grid.Row="3" Grid.ColumnSpan="5" Header="팔레트 (이번 회차, 칸 번호 = DB pallet_slot)" Style="{StaticResource Section}">
                <!-- 김하균 패널이 들어오는 자리 (PanelSlots.LinePallet) -->
                <ContentControl Content="{Binding PalletPanel}" Focusable="False"/>
            </HeaderedContentControl>

            <!-- ── 분류 개수 (김초아) ── -->
                <HeaderedContentControl Grid.Row="1" Grid.Column="2" Header="분류 개수" Style="{StaticResource Section}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="Rectangle">
                                <Setter Property="Width" Value="12"/>
                                <Setter Property="Height" Value="12"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Rectangle Grid.Row="0" Fill="{StaticResource Brush.GradeA}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="A  → AGV" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding CountA}" Style="{StaticResource Readout}" FontSize="22"/>

                        <Rectangle Grid.Row="1" Fill="{StaticResource Brush.GradeNG}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="불량  → 불량함" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CountNg}" Style="{StaticResource Readout}" FontSize="22"/>

                        <Rectangle Grid.Row="2" Fill="{StaticResource Brush.GradeResort}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="재분류  → 재분류함" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding CountResort}" Style="{StaticResource Readout}" FontSize="22"/>

                        <Border Grid.Row="3" Grid.ColumnSpan="3" BorderBrush="{StaticResource Brush.Rule}" BorderThickness="0,1,0,0"
                                Padding="0,8,0,0" Margin="0,4,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource Font.Readout}" FontSize="15">
                                    <Run Text="{Binding Total, Mode=OneWay}"/>
                                    <Run Text="개,  A" Foreground="{StaticResource Brush.SubText}"/>
                                    <Run Text="{Binding ARatio, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="합계" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </HeaderedContentControl>


            <!-- ── AGV (김초아): 공정의 마지막 칸 (A 건전지 운송). 크게: 왼쪽 상태, 오른쪽 기록 ── -->
            <HeaderedContentControl Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Header="AGV" Style="{StaticResource Section}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.Resources>
                        <Style x:Key="AgvValue" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="17"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style x:Key="AgvLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </Grid.Resources>

                    <!-- 왼쪽: 상태 (이상일 때만 색) -->
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AgvLink}" Style="{StaticResource AgvValue}"
                                       Foreground="{Binding AgvLinkKey, Converter={StaticResource StatusToBrush}}"/>
                            <TextBlock Text="연결" Style="{StaticResource AgvLabel}"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AgvState}" Style="{StaticResource AgvValue}"
                                       Foreground="{Binding AgvStateKey, Converter={StaticResource StatusToBrush}}"/>
                            <TextBlock Text="위치" Style="{StaticResource AgvLabel}"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AgvCarrying}" Style="{StaticResource AgvValue}"/>
                            <TextBlock Text="지게" Style="{StaticResource AgvLabel}"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AgvLoad}" Style="{StaticResource Readout}" FontSize="20"/>
                            <TextBlock Text="A 적재 / 출발 기준" Style="{StaticResource AgvLabel}"/>
                        </DockPanel>
                        <ProgressBar Value="{Binding AgvFill, Mode=OneWay}" Maximum="100" Height="14" Margin="0,6,0,0"
                                     Foreground="{StaticResource Brush.GradeA}" Background="{StaticResource Brush.Field}"
                                     BorderBrush="{StaticResource Brush.Rule}"/>
                    </StackPanel>

                    <!-- 오른쪽: 기록 (최근이 위, 시:분:초, 경고·오류만 색) -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="기록 (최근이 위)" Style="{StaticResource AgvLabel}" Margin="0,0,0,4"/>
                        <Border BorderBrush="{StaticResource Brush.Rule}" BorderThickness="1" Background="{StaticResource Brush.Field}"
                                Height="150">
                            <ItemsControl ItemsSource="{Binding AgvLog}" Focusable="False">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:AgvLogRow}">
                                        <DockPanel Margin="0,2">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="72" FontSize="13"
                                                       FontFamily="{StaticResource Font.Readout}" Foreground="{StaticResource Brush.SubText}"/>
                                            <TextBlock Text="{Binding Message}" FontSize="13.5" TextWrapping="Wrap"
                                                       Foreground="{Binding LevelKey, Converter={StaticResource StatusToBrush}}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </DockPanel>
                </Grid>
            </HeaderedContentControl>

            <!-- ── 조작 ── -->
            <HeaderedContentControl Grid.Row="1" Grid.Column="4" Header="라인 조작" Style="{StaticResource Section}" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="상태" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding ModeText}" Style="{StaticResource Readout}" FontSize="22"
                                       Foreground="{Binding Mode, Converter={StaticResource StatusToBrush}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="단계" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding StepText}" Style="{StaticResource Readout}" FontSize="22"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="건전지 번호" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding BatteryText}" Style="{StaticResource ReadoutSmall}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 아래 버튼은 유동호 패널이 들어오는 자리 (PanelSlots.LineControls) -->
                    <ContentControl Content="{Binding ControlPanel}" Focusable="False"/>
                </StackPanel>
            </HeaderedContentControl>

            <!-- ── 환경 센서: 온습도 그래프 · 가스 감시 (조시현, EnvPanel.xaml). 스크롤 내리면 보임, 맨 위에 한 줄 요약 ── -->
            <local:EnvPanel Grid.Row="4" Grid.ColumnSpan="5" Margin="0,10,0,0" DataContext="{Binding Env}"/>

            <!-- ── 서버 메시지 ── -->
            <Border Grid.Row="5" Grid.ColumnSpan="5" Style="{StaticResource Box}" Margin="0,10,0,0"
                    Visibility="{Binding ServerMessage, Converter={StaticResource TextToVis}}">
                <DockPanel>
                    <TextBlock Text="서버 메시지" Style="{StaticResource Label}" Width="80" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ServerMessage}" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
