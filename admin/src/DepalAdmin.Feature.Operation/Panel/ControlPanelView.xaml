<UserControl x:Class="DepalAdmin.Feature.Operation.Panel.ControlPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:DepalAdmin.Feature.Operation.Panel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:ControlPanelViewModel}"
             d:DesignWidth="280" d:DesignHeight="280">
    <!-- 바깥 상자(제목 줄)는 라인 현황 화면이 그린다. 여기는 안쪽 내용만. -->
    <StackPanel>
        <UniformGrid Columns="2">
            <Button Content="시작" Command="{Binding StartCommand}" Style="{StaticResource CmdMain}" Margin="0,0,6,6" MinHeight="40"/>
            <Button Content="일시정지" Command="{Binding PauseCommand}" Style="{StaticResource Cmd}" Margin="0,0,0,6" MinHeight="40"/>
            <Button Content="재개" Command="{Binding ResumeCommand}" Style="{StaticResource Cmd}" Margin="0,0,6,6" MinHeight="40"/>
            <Button Content="회차 종료" Command="{Binding StopCommand}" Style="{StaticResource Cmd}" Margin="0,0,0,6" MinHeight="40"/>
            <Button Content="건너뛰기" Command="{Binding SkipCommand}" Style="{StaticResource Cmd}" Margin="0,0,6,6" MinHeight="40"/>
            <Button Content="비상정지 해제" Command="{Binding ResetCommand}" Style="{StaticResource Cmd}" Margin="0,0,0,6" MinHeight="40"/>
        </UniformGrid>

        <!-- 라인 상태 안내 / 장비 이상(ARM2_FAILED, pick 실패) / 비상정지 물리 버튼 복귀 안내 배너 -->
        <Border Margin="0,4,0,0" Padding="8,6" BorderThickness="1"
                BorderBrush="{Binding StatusLevel, Converter={StaticResource StatusToBrush}}"
                Background="{Binding StatusLevel, Converter={StaticResource StatusToFill}}"
                Visibility="{Binding StatusGuide, Converter={StaticResource TextToVis}}">
            <TextBlock Text="{Binding StatusGuide}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{Binding StatusLevel, Converter={StaticResource StatusToBrush}}"/>
        </Border>

        <TextBlock Text="{Binding PermissionHint}" Style="{StaticResource Hint}" Foreground="{StaticResource Brush.Warn}"
                   Visibility="{Binding PermissionHint, Converter={StaticResource TextToVis}}" Margin="0,6,0,0"/>
        <TextBlock Text="{Binding CommandResult}" Style="{StaticResource Hint}"
                   Visibility="{Binding CommandResult, Converter={StaticResource TextToVis}}" Margin="0,4,0,0"/>
    </StackPanel>
</UserControl>