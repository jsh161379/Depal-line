<UserControl x:Class="BareunOrder.Feature.Orders.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 담당: (미정) — F1 주문. 왼쪽 목록, 오른쪽 상세. -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- ═══ 왼쪽: 목록 ═══ -->
        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <!-- 상태 거르기 + 검색 -->
                <Grid DockPanel.Dock="Top" Margin="8,4,12,0">
                    <ListBox Style="{StaticResource FilterBar}" ItemsSource="{Binding Filters}"
                             SelectedItem="{Binding CurrentFilter}" HorizontalAlignment="Left">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBlock Text="{Binding Count}" Margin="6,0,0,0" FontFamily="{StaticResource Mono}"
                                               Foreground="{StaticResource Ink3}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid HorizontalAlignment="Right" Width="260" VerticalAlignment="Center">
                        <TextBox Style="{StaticResource Input}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="주문번호 · 이름 · 연락처 뒤 4자리" Foreground="{StaticResource Ink3}" FontSize="13"
                                   Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Search}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>

                <!-- 머리줄 -->
                <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                        BorderThickness="0,1" Padding="20,9,12,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="시각" Style="{StaticResource ColHead}" />
                        <TextBlock Grid.Column="1" Text="주문번호" Style="{StaticResource ColHead}" />
                        <TextBlock Grid.Column="2" Text="고객" Style="{StaticResource ColHead}" />
                        <TextBlock Grid.Column="3" Text="상품" Style="{StaticResource ColHead}" />
                        <TextBlock Grid.Column="4" Text="금액" Style="{StaticResource ColHead}" HorizontalAlignment="Right" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="5" Text="상태" Style="{StaticResource ColHead}" />
                    </Grid>
                </Border>

                <!-- 아래 안내 -->
                <TextBlock DockPanel.Dock="Bottom" Margin="16,8" Style="{StaticResource Caption}"
                           Text="목록에서 주문을 고르고 Enter = 다음 단계" />

                <Grid>
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding View}"
                             SelectedItem="{Binding Selected}" FocusVisualStyle="{x:Null}">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AdvanceCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ReceivedAt, StringFormat={}{0:HH:mm}}" FontFamily="{StaticResource Mono}"
                                               Foreground="{StaticResource Ink2}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding No}" FontFamily="{StaticResource Mono}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding ItemsSummary}" Foreground="{StaticResource Ink2}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="4" Text="{Binding Total, StringFormat={}{0:N0}}" FontFamily="{StaticResource Mono}"
                                               FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <ContentPresenter Grid.Column="5" Content="{Binding}" ContentTemplate="{StaticResource StatusChip}"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="해당하는 주문이 없습니다" Foreground="{StaticResource Ink3}" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding View.IsEmpty, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- ═══ 오른쪽: 상세 ═══ -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <TextBlock Text="왼쪽 목록에서 주문을 고르세요" Foreground="{StaticResource Ink3}" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Selected, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}" />

                <DockPanel Visibility="{Binding Selected, Converter={StaticResource NullToCollapsed}}">
                    <!-- 버튼 (아래 고정) -->
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                            BorderThickness="0,1,0,0" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource Btn.Primary}" MinHeight="48" FontSize="15" Command="{Binding AdvanceCommand}">
                                <TextBlock>
                                    <Run Text="{Binding Selected.NextStatusText, Mode=OneWay}" /><Run Text=" (으)로  →" />
                                </TextBlock>
                            </Button>
                            <Button Grid.Column="2" Content="주문 취소" Style="{StaticResource Btn.Danger}" MinHeight="48"
                                    Command="{Binding CancelCommand}" />
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,18,20,20">
                            <!-- 주문번호, 상태 -->
                            <TextBlock Text="{Binding Selected.No}" FontFamily="{StaticResource Mono}" FontSize="22" FontWeight="Bold" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ContentPresenter Content="{Binding Selected}" ContentTemplate="{StaticResource StatusChip}" />
                                <TextBlock Text="{Binding Selected.ReceivedAt, StringFormat={}{0:yyyy-MM-dd HH:mm} 접수}"
                                           Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- 고객 -->
                            <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,18" />
                            <TextBlock Text="고객" Style="{StaticResource SectionTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="이름" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Selected.Name}" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Text="연락처" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,10,0,0" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding PhoneText}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
                                    <ToggleButton Content="번호 보기" IsChecked="{Binding ShowPhone}" Margin="10,0,0,0"
                                                  Padding="8,2" FontSize="12" Cursor="Hand" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="주소" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.Address}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </Grid>

                            <!-- 요청 사항 (있을 때만, 눈에 띄게) -->
                            <Border Background="{StaticResource AmberSoft}" CornerRadius="3" Padding="12,10" Margin="0,12,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Selected.Memo}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="요청 사항  " FontWeight="Bold" Foreground="{StaticResource Amber}" />
                                    <Run Text="{Binding Selected.Memo, Mode=OneWay}" />
                                </TextBlock>
                            </Border>

                            <!-- 상품 -->
                            <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,18" />
                            <TextBlock Text="상품" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding Selected.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Qty, StringFormat=×{0}}" FontFamily="{StaticResource Mono}"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat={}{0:N0}원}" FontFamily="{StaticResource Mono}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                                    <Run Text="건전지" /><Run Text="{Binding Selected.BatteryCount, Mode=OneWay}" /><Run Text="개 필요" />
                                </TextBlock>
                                <TextBlock Text="{Binding Selected.Total, StringFormat={}{0:N0}원}" FontFamily="{StaticResource Mono}"
                                           FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- 배송 (송장이 있을 때만) -->
                            <StackPanel Visibility="{Binding Selected.Tracking, Converter={StaticResource NullToCollapsed}}">
                                <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,18" />
                                <TextBlock Text="배송" Style="{StaticResource SectionTitle}" />
                                <TextBlock>
                                    <Run Text="{Binding Selected.Courier, Mode=OneWay}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding Selected.Tracking, Mode=OneWay}" FontFamily="{StaticResource Mono}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
