<UserControl x:Class="BareunOrder.Feature.Stock.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 담당: 김하균 — F3 재고. 11/23 ⑪ 안 A: 재고는 라인 A 등급 수로 자동 계산 (손 입고 없음) -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- ═══ 왼쪽: 상품별 재고 ═══ -->
        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,14,16,10">
                    <TextBlock Text="상품별 재고" Style="{StaticResource SectionTitle}" Margin="0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                            <Run Text="남은 팩이" /><Run Text="{Binding LowLimit, Mode=OneWay}" /><Run Text="팩 이하면 빨간색" />
                        </TextBlock>
                        <Button Content="새로 고침" Style="{StaticResource Btn.Small}" Margin="12,0,0,0"
                                ToolTip="라인 A 남은 수를 DB에서 다시 읽기"
                                Command="{Binding LoadFromDbCommand}" />
                    </StackPanel>
                </Grid>
                <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                        BorderThickness="0,1" Padding="20,9,16,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="상품" Style="{StaticResource ColHead}" />
                        <TextBlock Grid.Column="1" Text="가격" Style="{StaticResource ColHead}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="A로 만들 수 있음" Style="{StaticResource ColHead}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="주문 대기" Style="{StaticResource ColHead}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="판매 가능" Style="{StaticResource ColHead}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>
                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="64">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Product.PackSize, StringFormat=팩당 {0}개}" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat={}{0:N0}원}" FontFamily="{StaticResource Mono}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Packs}" FontFamily="{StaticResource Mono}" FontSize="16"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Reserved}" FontFamily="{StaticResource Mono}" FontSize="16"
                                           Foreground="{StaticResource Ink2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <Border Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="3" Padding="10,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource GreenSoft}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource RedSoft}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontFamily="{StaticResource Mono}" FontSize="18" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Green}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding Available, Mode=OneWay}" /><Run Text="팩" FontSize="13" />
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ═══ 오른쪽: 라인 A 등급, A 쓰임, 안내 ═══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="라인 A 등급 남음 (아직 주문에 안 나감)" Style="{StaticResource Caption}" />
                    <TextBlock Style="{StaticResource BigNumber}">
                        <Run Text="{Binding LineReadyA, Mode=OneWay}" /><Run Text="개" FontSize="16" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="검사를 통과한 A 등급 건전지 수로 팩 수를 자동 계산합니다. 상품끼리 같은 A를 나눠 씁니다." />
                </StackPanel>
            </Border>

            <!-- 입고 카드 자리: 손 입고 없음, 안내 한 줄 -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{Binding StockNote}" />
            </Border>

            <!-- 입고 기록 카드 자리: A 등급 쓰임 -->
            <Border Grid.Row="4" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="A 등급 쓰임" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="주문 대기에 필요한 A" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" FontFamily="{StaticResource Mono}" FontSize="16">
                            <Run Text="{Binding PendingNeedA, Mode=OneWay}" /><Run Text="개" FontSize="13" />
                        </TextBlock>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="새 주문에 쓸 수 있는 A" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" FontFamily="{StaticResource Mono}" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource Green}">
                            <Run Text="{Binding FreeA, Mode=OneWay}" /><Run Text="개" FontSize="13" />
                        </TextBlock>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="{Binding SupplyText}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
