<UserControl x:Class="BareunOrder.Feature.Stock.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 담당: (미정) — F3 재고 -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- ═══ 왼쪽: 상품별 재고 ═══ -->
        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,14,16,10">
                    <TextBlock Text="상품별 재고" Style="{StaticResource SectionTitle}" Margin="0" />
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource Caption}" VerticalAlignment="Center">
                        <Run Text="남은 팩이" /><Run Text="{Binding LowLimit, Mode=OneWay}" /><Run Text="팩 이하면 빨간색" />
                    </TextBlock>
                </Grid>
                <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                        BorderThickness="0,1" Padding="20,9,16,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="상품" Style="{StaticResource ColHead}" />
                        <TextBlock Grid.Column="1" Text="가격" Style="{StaticResource ColHead}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="창고" Style="{StaticResource ColHead}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="주문에 묶임" Style="{StaticResource ColHead}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="판매 가능" Style="{StaticResource ColHead}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>
                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="64">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Product.PackSize, StringFormat=팩당 {0}개}" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat={}{0:N0}원}" FontFamily="{StaticResource Mono}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Packs}" FontFamily="{StaticResource Mono}" FontSize="16"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Reserved}" FontFamily="{StaticResource Mono}" FontSize="16"
                                           Foreground="{StaticResource Ink2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <Border Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="3" Padding="10,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource GreenSoft}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource RedSoft}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontFamily="{StaticResource Mono}" FontSize="18" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Green}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding Available, Mode=OneWay}" /><Run Text="팩" FontSize="13" />
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ═══ 오른쪽: 라인 A 등급, 입고, 기록 ═══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="오늘 라인 A 등급 (포장 전)" Style="{StaticResource Caption}" />
                    <TextBlock Style="{StaticResource BigNumber}">
                        <Run Text="{Binding LineReadyA, Mode=OneWay}" /><Run Text="개" FontSize="16" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="검사를 통과한 건전지만 팩으로 포장해 입고합니다. (라인 연동 준비 중)" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="입고" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Caption}" Text="왼쪽에서 상품을 고르세요"
                               Visibility="{Binding Selected, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}" />
                    <StackPanel Visibility="{Binding Selected, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Selected.Name}" FontSize="16" FontWeight="Bold" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource Input}" FontFamily="{StaticResource Mono}" FontSize="16"
                                     Text="{Binding AddPacks, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Content="+ 팩 입고" Style="{StaticResource Btn.Primary}"
                                    Command="{Binding AddStockCommand}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="입고 기록" Style="{StaticResource SectionTitle}" Margin="16,14,16,10" />
                    <ListBox ItemsSource="{Binding History}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}"
                             FontFamily="{StaticResource Mono}" FontSize="13" Padding="8" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
