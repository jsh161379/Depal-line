<UserControl x:Class="BareunOrder.Feature.Customers.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 담당: 조시현 — F5 고객·문의 -->
    <UserControl.Resources>
        <!-- 문의 상태 (색 + 글자): 답변 대기 = 호박색, 답변 완료 = 초록. DataContext가 Inquiry일 때 -->
        <DataTemplate x:Key="InquiryChip">
            <Border x:Name="Bd" CornerRadius="3" Padding="8,3" HorizontalAlignment="Left" Background="{StaticResource AmberSoft}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{StaticResource Amber}" />
                    <TextBlock x:Name="Tx" Text="답변 대기" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amber}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAnswered}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource GreenSoft}" />
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Green}" />
                    <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource Green}" />
                    <Setter TargetName="Tx" Property="Text" Value="답변 완료" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 문의 한 줄 (왼쪽 목록, 고객 화면의 문의 목록에서 같이 씀) -->
        <DataTemplate x:Key="InquiryRow">
            <Grid Height="58" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource InquiryChip}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock>
                        <Run Text="{Binding TypeText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Name, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Question}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" MaxHeight="17" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding No}" FontFamily="{StaticResource Mono}" FontSize="12" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding AskedAt, StringFormat={}{0:MM-dd HH:mm}}" FontFamily="{StaticResource Mono}"
                               Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="480" />
        </Grid.ColumnDefinitions>

        <!-- ═══ 왼쪽: 고객 목록 / 문의 목록 ═══ -->
        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <!-- 전환 -->
                <Grid DockPanel.Dock="Top" Margin="8,4,16,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource FilterTab}" GroupName="Mode" IsChecked="{Binding IsCustomerMode}">
                            <TextBlock><Run Text="고객 " /><Run Text="{Binding CustomerCount, Mode=OneWay}" Foreground="{StaticResource Ink3}" /></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterTab}" GroupName="Mode" IsChecked="{Binding IsInquiryMode}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="문의" />
                                <Border Background="{StaticResource Amber}" CornerRadius="9" MinWidth="20" Height="18" Padding="5,0" Margin="6,0,0,0"
                                        Visibility="{Binding UnansweredCount, Converter={StaticResource ZeroToCollapsed}}">
                                    <TextBlock Text="{Binding UnansweredCount}" Foreground="White" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <TextBox Style="{StaticResource Input}" Width="240" HorizontalAlignment="Right" VerticalAlignment="Center"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="이름 또는 연락처"
                             Visibility="{Binding IsCustomerMode, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- 고객 목록 -->
                <DockPanel Visibility="{Binding IsCustomerMode, Converter={StaticResource BoolToVis}}">
                    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                            BorderThickness="0,1" Padding="20,9,16,9" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="이름" Style="{StaticResource ColHead}" />
                            <TextBlock Grid.Column="1" Text="연락처" Style="{StaticResource ColHead}" />
                            <TextBlock Grid.Column="2" Text="주문" Style="{StaticResource ColHead}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="누적 금액" Style="{StaticResource ColHead}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="최근 주문" Style="{StaticResource ColHead}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Customers}" SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="50">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding MaskedPhone}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding OrderCount, StringFormat={}{0}건}" FontFamily="{StaticResource Mono}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding TotalSpent, StringFormat={}{0:N0}원}" FontFamily="{StaticResource Mono}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding LastOrderAt, StringFormat={}{0:MM-dd HH:mm}}" FontFamily="{StaticResource Mono}"
                                               Foreground="{StaticResource Ink2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- 문의 목록 -->
                <DockPanel Visibility="{Binding IsInquiryMode, Converter={StaticResource BoolToVis}}">
                    <ListBox DockPanel.Dock="Top" Style="{StaticResource FilterBar}" ItemsSource="{Binding Filters}"
                             SelectedItem="{Binding CurrentFilter}" DisplayMemberPath="Label" Margin="8,4,8,0" />
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="16,8"
                               Text="{Binding InquiryConnection, StringFormat='문의 연결: {0}'}" />
                    <Grid>
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding InquiryList}" SelectedItem="{Binding SelectedInquiry}"
                                 ItemTemplate="{StaticResource InquiryRow}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" />
                        <TextBlock Text="해당하는 문의가 없습니다" Foreground="{StaticResource Ink3}" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding InquiryList.Count, Converter={StaticResource ZeroToCollapsed}, ConverterParameter=invert}" />
                    </Grid>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- ═══ 오른쪽 (고객 모드): 고객 정보·메모·주문 이력·문의 ═══ -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0"
                Visibility="{Binding IsCustomerMode, Converter={StaticResource BoolToVis}}">
            <Grid>
                <TextBlock Text="왼쪽에서 고객을 고르세요" Foreground="{StaticResource Ink3}" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Selected, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}" />
                <DockPanel Visibility="{Binding Selected, Converter={StaticResource NullToCollapsed}}">
                    <StackPanel DockPanel.Dock="Top" Margin="16,14,16,10">
                        <TextBlock Text="{Binding Selected.Name}" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="{Binding Selected.MaskedPhone}" FontFamily="{StaticResource Mono}" Style="{StaticResource Caption}" />

                        <TextBlock Text="고객 메모" Style="{StaticResource ColHead}" Margin="0,14,0,4" />
                        <TextBox Style="{StaticResource Input}" Text="{Binding MemoText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="예: 부재 시 경비실에 맡겨 주세요" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="56" VerticalContentAlignment="Top" Padding="8,6" />
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="{Binding MemoMessage}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <Button Content="메모 저장" Style="{StaticResource Btn.Small}" HorizontalAlignment="Right"
                                    Command="{Binding SaveMemoCommand}" />
                        </Grid>
                    </StackPanel>
                    <TabControl BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" Padding="0" FontSize="14">
                        <TabItem Header="  주문 이력  " Height="40">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Text="주문을 두 번 누르면 주문 탭에서 열립니다" Style="{StaticResource Caption}" Margin="16,8" />
                                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Selected.Orders}"
                                         MouseDoubleClick="OnOrderDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="54" Background="Transparent">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding No}" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ItemsSummary}" Style="{StaticResource Caption}" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Total, StringFormat={}{0:N0}원}" FontFamily="{StaticResource Mono}"
                                                               HorizontalAlignment="Right" />
                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusChip}"
                                                                      HorizontalAlignment="Right" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </TabItem>
                        <TabItem Height="40">
                            <TabItem.Header>
                                <TextBlock><Run Text="  문의 " /><Run Text="{Binding SelectedInquiries.Count, Mode=OneWay}" /><Run Text="  " /></TextBlock>
                            </TabItem.Header>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Text="문의를 두 번 누르면 문의 목록에서 열립니다" Style="{StaticResource Caption}" Margin="16,8" />
                                <Grid>
                                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding SelectedInquiries}"
                                             ItemTemplate="{StaticResource InquiryRow}" MouseDoubleClick="OnInquiryDoubleClick" />
                                    <TextBlock Text="이 연락처로 받은 문의가 없습니다" Foreground="{StaticResource Ink3}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding SelectedInquiries.Count, Converter={StaticResource ZeroToCollapsed}, ConverterParameter=invert}" />
                                </Grid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ═══ 오른쪽 (문의 모드): 문의 내용·답변 ═══ -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0"
                Visibility="{Binding IsInquiryMode, Converter={StaticResource BoolToVis}}">
            <Grid>
                <TextBlock Text="왼쪽에서 문의를 고르세요" Foreground="{StaticResource Ink3}" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding SelectedInquiry, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}" />
                <DockPanel Margin="16,14,16,16" Visibility="{Binding SelectedInquiry, Converter={StaticResource NullToCollapsed}}">
                    <!-- 머리: 번호·상태·유형 -->
                    <StackPanel DockPanel.Dock="Top">
                        <Grid>
                            <TextBlock Text="{Binding SelectedInquiry.No}" FontFamily="{StaticResource Mono}" FontSize="18" FontWeight="Bold" />
                            <ContentPresenter Content="{Binding SelectedInquiry}" ContentTemplate="{StaticResource InquiryChip}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Margin="0,6,0,0">
                            <Run Text="{Binding SelectedInquiry.TypeText, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" · " Foreground="{StaticResource Ink3}" />
                            <Run Text="{Binding SelectedInquiry.Name, Mode=OneWay}" />
                            <Run Text=" · " Foreground="{StaticResource Ink3}" />
                            <Run Text="{Binding SelectedInquiry.MaskedPhone, Mode=OneWay}" FontFamily="{StaticResource Mono}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   Text="{Binding SelectedInquiry.AskedAt, StringFormat='문의 시각 {0:yyyy-MM-dd HH:mm}'}" />
                        <Grid Margin="0,10,0,0" Visibility="{Binding SelectedInquiry.OrderNo, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="주문번호 " Foreground="{StaticResource Ink2}" /><Run Text="{Binding SelectedInquiry.OrderNo, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" />
                            </TextBlock>
                            <Button Content="주문 열기" Style="{StaticResource Btn.Small}" HorizontalAlignment="Right"
                                    Command="{Binding OpenInquiryOrderCommand}" />
                        </Grid>
                    </StackPanel>

                    <!-- 아래: 답변 쓰기 -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock Text="자주 쓰는 답변 (누르면 입력칸에 들어감)" Style="{StaticResource ColHead}" Margin="0,4,0,6" />
                        <ItemsControl ItemsSource="{Binding QuickAnswers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Btn.Small}" Margin="0,0,0,6" HorizontalContentAlignment="Left" Padding="10,4"
                                            Command="{Binding DataContext.UseQuickAnswerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontWeight="Normal" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Style="{StaticResource Input}" Text="{Binding AnswerDraft, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="110" VerticalContentAlignment="Top" Padding="8,6"
                                 VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" MaxLength="1000" />
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="{Binding AnswerMessage}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="0,0,160,0" />
                            <Button Content="{Binding SendButtonText}" Style="{StaticResource Btn.Primary}" MinHeight="48"
                                    HorizontalAlignment="Right" Command="{Binding SendAnswerCommand}" />
                        </Grid>
                    </StackPanel>

                    <!-- 가운데: 질문, 보낸 답변 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,12">
                        <StackPanel>
                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    CornerRadius="4" Padding="12,10">
                                <TextBlock Text="{Binding SelectedInquiry.Question}" TextWrapping="Wrap" FontSize="14" LineHeight="22" />
                            </Border>
                            <Border Background="{StaticResource BlueSoft}" BorderBrush="{StaticResource Blue}" BorderThickness="3,0,0,0"
                                    Padding="12,10" Margin="0,10,0,0"
                                    Visibility="{Binding SelectedInquiry.Answer, Converter={StaticResource NullToCollapsed}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource Blue}" FontWeight="SemiBold">
                                        <Run Text="보낸 답변 · " /><Run Text="{Binding SelectedInquiry.AnsweredBy, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SelectedInquiry.AnsweredAt, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm}}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding SelectedInquiry.Answer}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="22" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
