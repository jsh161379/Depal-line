<UserControl x:Class="BareunOrder.Feature.Stats.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 담당: (미정) — F4 통계 -->
    <UserControl.Resources>
        <!-- 납작한 막대 (애니메이션 없는 ProgressBar) -->
        <Style x:Key="FlatBar" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Blue}" />
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" Background="{TemplateBinding Background}">
                            <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ 기간, 내보내기 ═══ -->
        <Grid>
            <ListBox Style="{StaticResource FilterBar}" ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}"
                     HorizontalAlignment="Left" DisplayMemberPath="Label" />
            <Button Content="엑셀 내보내기" Style="{StaticResource Btn.Small}" HorizontalAlignment="Right"
                    Command="{Binding ExportCommand}" />
        </Grid>

        <!-- ═══ 숫자 4칸 ═══ -->
        <UniformGrid Grid.Row="2" Rows="1">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="주문 수 (취소 제외)" Style="{StaticResource Caption}" />
                    <TextBlock Style="{StaticResource BigNumber}">
                        <Run Text="{Binding OrderCount, Mode=OneWay}" /><Run Text="건" FontSize="16" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="매출" Style="{StaticResource Caption}" />
                    <TextBlock Style="{StaticResource BigNumber}">
                        <Run Text="{Binding Sales, Mode=OneWay, StringFormat={}{0:N0}}" /><Run Text="원" FontSize="16" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding AverageOrder, StringFormat=주문당 평균 {0:N0}원}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="판매 팩 수" Style="{StaticResource Caption}" />
                    <TextBlock Style="{StaticResource BigNumber}">
                        <Run Text="{Binding PackCount, Mode=OneWay}" /><Run Text="팩" FontSize="16" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="취소율" Style="{StaticResource Caption}" />
                    <TextBlock Style="{StaticResource BigNumber}">
                        <Run Text="{Binding CancelRate, Mode=OneWay, StringFormat={}{0:0.0}}" /><Run Text="%" FontSize="16" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ═══ 그래프 2개 ═══ -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 상품별 매출 -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="상품별 매출" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding ByProduct}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Style="{StaticResource FlatBar}" Height="22" Value="{Binding Ratio, Mode=OneWay}" />
                                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontFamily="{StaticResource Mono}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- 시간대별 주문 수 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="시간대별 주문 수" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding ByHour}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="3,0">
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" Style="{StaticResource Caption}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding ValueText}" FontFamily="{StaticResource Mono}"
                                               FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                    <!-- 가로 막대를 -90도 돌려서 아래에서 위로 차게 -->
                                    <ProgressBar Style="{StaticResource FlatBar}" Value="{Binding Ratio, Mode=OneWay}">
                                        <ProgressBar.LayoutTransform>
                                            <RotateTransform Angle="-90" />
                                        </ProgressBar.LayoutTransform>
                                    </ProgressBar>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
