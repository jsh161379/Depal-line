<UserControl x:Class="BareunOrder.Feature.Stats.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 담당: 장성찬 — F4 통계 -->
    <UserControl.Resources>
        <!-- 납작한 막대 (애니메이션 없는 ProgressBar) -->
        <Style x:Key="FlatBar" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Blue}" />
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" Background="{TemplateBinding Background}">
                            <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DateBox" TargetType="DatePicker">
            <Setter Property="Width" Value="130" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="SelectedDateFormat" Value="Short" />
        </Style>
        <!-- 숫자 칸 아래 "전주 대비 +3건" -->
        <Style x:Key="DiffText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ 기간 고르기, 내보내기 ═══ -->
        <DockPanel LastChildFill="False">
            <ListBox DockPanel.Dock="Left" Style="{StaticResource FilterBar}" ItemsSource="{Binding PeriodOptions}"
                     SelectedItem="{Binding SelectedOption}" DisplayMemberPath="Label" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button Content="◀" Style="{StaticResource Btn.Small}" Command="{Binding PrevCommand}" ToolTip="이전 기간" />
                <DatePicker Style="{StaticResource DateBox}" Margin="8,0,0,0" ToolTip="시작일"
                            SelectedDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="~" VerticalAlignment="Center" Margin="6,0" Foreground="{StaticResource Ink2}" />
                <DatePicker Style="{StaticResource DateBox}" ToolTip="종료일 (그날 포함)"
                            SelectedDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="▶" Style="{StaticResource Btn.Small}" Command="{Binding NextCommand}" Margin="8,0,0,0" ToolTip="다음 기간" />
                <Button Content="오늘" Style="{StaticResource Btn.Small}" Command="{Binding TodayCommand}" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 데이터 출처: DB 기준 · 15:02 불러옴 / 가짜 주문 / DB 조회 실패 -->
                <TextBlock Text="{Binding SourceText}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           MaxWidth="320" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceText}" Margin="0,0,12,0" />
                <Button Content="새로고침" Style="{StaticResource Btn.Small}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Content="엑셀 내보내기" Style="{StaticResource Btn.Small}" Command="{Binding ExportCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- 지금 기간 -->
        <TextBlock Grid.Row="2" Text="{Binding PeriodText}" Style="{StaticResource Caption}" FontSize="13" />

        <!-- ═══ 숫자 5칸 ═══ -->
        <UniformGrid Grid.Row="4" Rows="1">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="주문 수 (취소 제외)" Style="{StaticResource Caption}" />
                    <TextBlock Style="{StaticResource BigNumber}">
                        <Run Text="{Binding OrderCount, Mode=OneWay}" /><Run Text="건" FontSize="16" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource DiffText}" Text="{Binding OrderDiffText}" ToolTip="{Binding OrderDiffText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="매출" Style="{StaticResource Caption}" />
                    <TextBlock Style="{StaticResource BigNumber}">
                        <Run Text="{Binding Sales, Mode=OneWay, StringFormat={}{0:N0}}" /><Run Text="원" FontSize="16" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource DiffText}" Text="{Binding SalesDiffText}" ToolTip="{Binding SalesDiffText}" />
                    <TextBlock Style="{StaticResource DiffText}" Text="{Binding AverageOrder, StringFormat=주문당 평균 {0:N0}원}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="판매 팩 수" Style="{StaticResource Caption}" />
                    <TextBlock Style="{StaticResource BigNumber}">
                        <Run Text="{Binding PackCount, Mode=OneWay}" /><Run Text="팩" FontSize="16" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource DiffText}" Text="{Binding PackDiffText}" ToolTip="{Binding PackDiffText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="취소율" Style="{StaticResource Caption}" />
                    <TextBlock Style="{StaticResource BigNumber}">
                        <Run Text="{Binding CancelRate, Mode=OneWay, StringFormat={}{0:0.0}}" /><Run Text="%" FontSize="16" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource DiffText}" Text="{Binding CancelDiffText}" ToolTip="{Binding CancelDiffText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="출고·배송 (배송 중 + 배송 완료)" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource BigNumber}">
                        <Run Text="{Binding ShippedCount, Mode=OneWay}" /><Run Text="건" FontSize="16" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource DiffText}" Text="{Binding PendingCount, StringFormat='처리 대기 {0}건 (접수·출고 검사)'}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ═══ 그래프 4개 (2×2) ═══ -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 일별 주문·매출 -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock Text="일별 주문·매출" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="막대 = 매출, 위 숫자 = 주문 수 (마우스를 올리면 자세히)" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ByDay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,0" ToolTip="{Binding Tip}" Background="Transparent">
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding SubLabel}" Style="{StaticResource Caption}"
                                               FontSize="11" HorizontalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" Style="{StaticResource Caption}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding ValueText}" FontFamily="{StaticResource Mono}"
                                               FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                    <ProgressBar Style="{StaticResource FlatBar}" Value="{Binding Ratio, Mode=OneWay}">
                                        <ProgressBar.LayoutTransform>
                                            <RotateTransform Angle="-90" />
                                        </ProgressBar.LayoutTransform>
                                    </ProgressBar>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- 상품별 매출 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="상품별 매출" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding ByProduct}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6" ToolTip="{Binding Tip}" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Style="{StaticResource FlatBar}" Height="20" Value="{Binding Ratio, Mode=OneWay}" />
                                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontFamily="{StaticResource Mono}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- 시간대별 주문 수 -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="시간대별 주문 수" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding ByHour}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="3,0" ToolTip="{Binding Tip}" Background="Transparent">
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" Style="{StaticResource Caption}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding ValueText}" FontFamily="{StaticResource Mono}"
                                               FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                    <!-- 가로 막대를 -90도 돌려서 아래에서 위로 차게 -->
                                    <ProgressBar Style="{StaticResource FlatBar}" Value="{Binding Ratio, Mode=OneWay}">
                                        <ProgressBar.LayoutTransform>
                                            <RotateTransform Angle="-90" />
                                        </ProgressBar.LayoutTransform>
                                    </ProgressBar>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- 주문 상태별 건수 -->
            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="주문 상태별 건수 (취소 포함)" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding ByStatus}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"
                                               Text="{Binding Count, StringFormat={}{0}건}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
