<Window x:Class="BareunOrder.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="바른전지 주문 관리" Width="1440" Height="900" MinWidth="1200" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic" FontSize="14"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}">
    <!-- 윈도우 기본 흰 제목 줄 대신, 위쪽 어두운 상태줄(56px)을 제목 줄로 쓴다. 끌어서 이동·두 번 클릭 최대화는 그대로 됨 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- 오른쪽 위 최소화·최대화·닫기 버튼 -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Foreground" Value="#C9D2DF" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F3849" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C8362F" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 위쪽 탭 한 칸 -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,3"
                                BorderBrush="Transparent" Padding="18,0" MinHeight="48">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F3849" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Blue}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0,3,0,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ═══ 위 상태줄 ═══ -->
        <Border Grid.Row="0" Background="{StaticResource Header}">
          <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="4" Background="{StaticResource Blue}">
                        <TextBlock Text="B" Foreground="White" FontWeight="Bold" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="바른전지 주문 관리" Foreground="White" FontSize="17" FontWeight="Bold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="24" Fill="#3A4456" Margin="20,0" />

                    <!-- 연결 상태 -->
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Red}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#3CC77A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="연결 끊김" />
                                <Setter Property="Foreground" Value="#FF9A93" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Text" Value="주문 수신 중" />
                                        <Setter Property="Foreground" Value="#C9D2DF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ConnectionText}" Foreground="#7F8A9C" FontSize="12"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 오늘 숫자 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,28,0">
                        <TextBlock Text="오늘 주문" Foreground="#9AA4B5" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TodayCount}" Foreground="White" FontSize="20" FontWeight="Bold"
                                   FontFamily="{StaticResource Mono}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,28,0">
                        <TextBlock Text="처리 대기" Foreground="#9AA4B5" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding WaitingCount}" Foreground="#FFC15E" FontSize="20" FontWeight="Bold"
                                   FontFamily="{StaticResource Mono}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="오늘 매출" Foreground="#9AA4B5" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TodaySales, StringFormat={}{0:N0}원}" Foreground="White" FontSize="20"
                                   FontWeight="Bold" FontFamily="{StaticResource Mono}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- 시계, 담당자 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Now, StringFormat={}{0:MM.dd (ddd)}, ConverterCulture=ko-KR}" Foreground="#9AA4B5"
                               FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Now, StringFormat={}{0:HH:mm:ss}}" Foreground="White" FontSize="20"
                               FontWeight="Bold" FontFamily="{StaticResource Mono}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="24" Fill="#3A4456" Margin="18,0" />
                    <TextBlock Text="담당" Foreground="#9AA4B5" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Operator}" Foreground="White" FontSize="14" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 최소화 · 최대화 · 닫기 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                <Button Style="{StaticResource CaptionBtn}" Content="&#xE921;" ToolTip="최소화" Click="OnMinimize" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionBtn}" Content="&#xE922;" ToolTip="최대화" Click="OnMaximize" />
                <Button Style="{StaticResource CaptionClose}" Content="&#xE8BB;" ToolTip="닫기" Click="OnClose" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- ═══ 탭 (F1~F6) ═══ -->
        <Border Grid.Row="1" Background="{StaticResource Nav}">
            <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding Selected}"
                     Background="Transparent" BorderThickness="0" Padding="8,0,0,0"
                     ItemContainerStyle="{StaticResource NavItem}" FocusVisualStyle="{x:Null}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="3" Padding="5,1" Margin="0,0,8,0" BorderThickness="1"
                                    BorderBrush="#4A5568" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Key}" FontSize="11" FontFamily="{StaticResource Mono}"
                                           Foreground="{StaticResource NavInk}" />
                            </Border>
                            <TextBlock x:Name="T" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource NavInk}" VerticalAlignment="Center" />
                            <Border Background="{StaticResource Red}" CornerRadius="9" MinWidth="20" Height="20"
                                    Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding Badge, Converter={StaticResource ZeroToCollapsed}}">
                                <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="T" Property="Foreground" Value="{StaticResource Ink}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ═══ 탭 화면 ═══ -->
        <ContentControl Grid.Row="2" Content="{Binding Selected.Page.View}" Focusable="False" />

        <!-- ═══ 오른쪽 아래 알림: 위 = 라인 메시지, 아래 = 새 주문 ═══ -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" Width="360">

        <!-- 라인 메시지 알림. 나를 부른 메시지면 노란색 -->
        <Border Margin="0,0,0,12" CornerRadius="4" BorderThickness="0,4,0,0"
                Visibility="{Binding ToastChat, Converter={StaticResource NullToCollapsed}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource Surface}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Green}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastChat.MentionsMe}" Value="True">
                            <Setter Property="Background" Value="{StaticResource AmberSoft}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" />
            </Border.Effect>
            <StackPanel Margin="18,14,18,16">
                <Grid>
                    <TextBlock FontSize="15" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="라인 메시지" />
                                <Setter Property="Foreground" Value="{StaticResource Green}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ToastChat.MentionsMe}" Value="True">
                                        <Setter Property="Text" Value="나를 부른 메시지" />
                                        <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource Btn.Small}" MinHeight="26"
                            Padding="8,0" BorderThickness="0" Command="{Binding CloseChatToastCommand}" />
                </Grid>
                <TextBlock Foreground="{StaticResource Ink2}" FontSize="12" Margin="0,6,0,2">
                    <Run Text="{Binding ToastChat.Who, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{Binding ToastChat.Station, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding ToastChat.Text}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" />
                <Button Content="메시지 보기" HorizontalAlignment="Right" Margin="0,10,0,0" Style="{StaticResource Btn}"
                        Command="{Binding OpenToastChatCommand}" />
            </StackPanel>
        </Border>

        <!-- 새 주문 알림 -->
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Blue}"
                BorderThickness="0,4,0,0" CornerRadius="4"
                Visibility="{Binding ToastOrder, Converter={StaticResource NullToCollapsed}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" />
            </Border.Effect>
            <StackPanel Margin="18,14,18,16">
                <Grid>
                    <TextBlock Text="새 주문이 들어왔습니다" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Blue}" />
                    <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource Btn.Small}" MinHeight="26"
                            Padding="8,0" BorderThickness="0" Command="{Binding CloseToastCommand}" />
                </Grid>
                <TextBlock Text="{Binding ToastOrder.No}" FontFamily="{StaticResource Mono}" FontSize="16"
                           FontWeight="Bold" Margin="0,8,0,2" />
                <TextBlock Foreground="{StaticResource Ink2}">
                    <Run Text="{Binding ToastOrder.Name, Mode=OneWay}" />
                    <Run Text=" · " />
                    <Run Text="{Binding ToastOrder.ItemsSummary, Mode=OneWay}" />
                </TextBlock>
                <Grid Margin="0,12,0,0">
                    <TextBlock Text="{Binding ToastOrder.Total, StringFormat={}{0:N0}원}" FontSize="20" FontWeight="Bold"
                               FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
                    <Button Content="주문 보기" HorizontalAlignment="Right" Style="{StaticResource Btn.Primary}"
                            Command="{Binding OpenToastOrderCommand}" />
                </Grid>
            </StackPanel>
        </Border>
        </StackPanel>

        <!-- ═══ 아래 줄 ═══ -->
        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock Text="F1~F7 탭 이동   ·   새 주문은 오른쪽 아래에 알림이 뜹니다" FontSize="12"
                           Foreground="{StaticResource Ink2}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding LastLog}" FontSize="12" Foreground="{StaticResource Ink2}"
                           FontFamily="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
