<UserControl x:Class="BareunOrder.Feature.Messages.MessagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 담당: 조시현 — F7 라인 메시지. 왼쪽 대화, 오른쪽 자주 쓰는 문구. -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- ═══ 왼쪽: 대화 ═══ -->
        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,14,16,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="현장 관리자와 메시지" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                        <TextBlock Text="관리자 프로그램 채팅과 같은 방" Style="{StaticResource Caption}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox Content="나를 부른 것만" IsChecked="{Binding OnlyMentionsMe}" FontSize="13"
                              HorizontalAlignment="Right" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                </Grid>

                <!-- 자리를 비운 사이 나를 부른 메시지 안내 -->
                <Border DockPanel.Dock="Top" Background="{StaticResource AmberSoft}" BorderBrush="{StaticResource Amber}"
                        BorderThickness="0,1" Padding="16,8"
                        Visibility="{Binding MentionNotice, Converter={StaticResource NullToCollapsed}}">
                    <Grid>
                        <TextBlock Text="{Binding MentionNotice}" Foreground="{StaticResource Amber}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="그 메시지만 보기" Style="{StaticResource Btn.Small}" Command="{Binding ShowMentionsCommand}" />
                            <Button Content="✕" Style="{StaticResource Btn.Small}" Margin="6,0,0,0" Padding="8,0"
                                    Command="{Binding CloseNoticeCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 입력 (아래 고정) -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                        BorderThickness="0,1,0,0" Padding="16,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="주문 붙이기" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding OpenOrders}" SelectedItem="{Binding AttachOrder}"
                                      MinHeight="34" FontSize="13" VerticalContentAlignment="Center" HorizontalAlignment="Left" Width="320">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding No, Mode=OneWay}" FontFamily="{StaticResource Mono}" />
                                            <Run Text="  " />
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                            <Run Text="  건전지 " /><Run Text="{Binding BatteryCount, Mode=OneWay}" /><Run Text="개" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="부를 사람" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0,10,0" />
                                <ComboBox ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}"
                                          DisplayMemberPath="Text" MinHeight="34" FontSize="13" Width="200"
                                          VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InputBox" Style="{StaticResource Input}" MinHeight="44"
                                     Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Content="보내기" Style="{StaticResource Btn.Primary}" MinHeight="44"
                                    Command="{Binding SendCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="2,6,0,0"
                                   Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <!-- 메시지 목록 -->
                <Grid>
                    <ListBox x:Name="MessageList" ItemsSource="{Binding View}" BorderThickness="0,1,0,0"
                             BorderBrush="{StaticResource Line}" Background="{StaticResource Bg}" Padding="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Margin="0,4" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel x:Name="Wrap" HorizontalAlignment="Left" MaxWidth="560">
                                    <TextBlock x:Name="Head" Style="{StaticResource Caption}" Margin="2,0,2,3">
                                        <Run Text="{Binding Who, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding Station, Mode=OneWay}" Foreground="{StaticResource Ink3}" />
                                        <Run Text="{Binding Time, Mode=OneWay, StringFormat={}{0:HH:mm}}" Foreground="{StaticResource Ink3}" />
                                        <Run Text="{Binding MentionText, Mode=OneWay}" Foreground="{StaticResource Blue}" />
                                    </TextBlock>
                                    <Border x:Name="Bubble" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1" CornerRadius="6" Padding="12,9">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" />
                                            <Button Style="{StaticResource Btn.Small}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                    Visibility="{Binding OrderNo, Converter={StaticResource NullToCollapsed}}"
                                                    Command="{Binding DataContext.OpenOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding OrderNo}">
                                                <TextBlock>
                                                    <Run Text="주문 열기  " /><Run Text="{Binding OrderNo, Mode=OneWay}" FontFamily="{StaticResource Mono}" />
                                                </TextBlock>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding MentionsMe}" Value="True">
                                        <Setter TargetName="Bubble" Property="Background" Value="{StaticResource AmberSoft}" />
                                        <Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource Amber}" />
                                        <Setter TargetName="Bubble" Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Mine}" Value="True">
                                        <Setter TargetName="Wrap" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="Head" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="Bubble" Property="Background" Value="{StaticResource BlueSoft}" />
                                        <Setter TargetName="Bubble" Property="BorderBrush" Value="#B9CDF2" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="아직 메시지가 없습니다" Foreground="{StaticResource Ink3}" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Lines.Count, Converter={StaticResource ZeroToCollapsed}, ConverterParameter=invert}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- ═══ 오른쪽: 자주 쓰는 문구 ═══ -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="자주 쓰는 문구" Style="{StaticResource SectionTitle}" />
                <ItemsControl ItemsSource="{Binding QuickTexts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Btn}" Margin="0,0,0,8" HorizontalContentAlignment="Left"
                                    Command="{Binding DataContext.UseQuickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontWeight="Normal" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="누르면 입력칸에 들어갑니다. 주문을 붙여 보내면 현장에서도 주문번호를 보고, 여기서는 [주문 열기]로 바로 열 수 있습니다." />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="@이름을 쓰거나 [부를 사람]에서 고르면 그 사람 화면에 강조·소리로 알려 갑니다. 나를 부른 메시지는 노란색으로 보입니다." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
