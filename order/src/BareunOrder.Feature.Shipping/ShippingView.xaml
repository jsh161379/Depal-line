<UserControl x:Class="BareunOrder.Feature.Shipping.ShippingView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- 담당: 노원종 — F2 출고·배송 -->
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <UniformGrid Rows="1" IsEnabled="{Binding IsIdle}">
   <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel>
    <TextBlock Text="출고 대기" Style="{StaticResource Caption}"/>
    <TextBlock Text="{Binding PendingCount, StringFormat={}{0}건}" Style="{StaticResource BigNumber}"/>
    <TextBlock Text="{Binding CheckedSummary}" Style="{StaticResource Caption}"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="8,0"><StackPanel>
    <TextBlock Text="출고에 필요한 건전지" Style="{StaticResource Caption}"/>
    <TextBlock Text="{Binding NeededBatteries, StringFormat={}{0:N0}개}" Style="{StaticResource BigNumber}"/>
    <TextBlock Text="전체 출고 대기 주문 기준" Style="{StaticResource Caption}"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="8,0,0,0"><DockPanel>
    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
     <Button Content="수량 새로 고침" Style="{StaticResource Btn.Small}" Command="{Binding RefreshSupplyCommand}" Margin="12,0,0,6"/>
     <Button Content="라인에 요청" Style="{StaticResource Btn.Small}" Command="{Binding RequestLineCommand}" Margin="12,0,0,0"/>
    </StackPanel>
    <StackPanel>
     <TextBlock Text="라인 A 등급 출고 가능" Style="{StaticResource Caption}"/>
     <TextBlock Text="{Binding LineReadyA, StringFormat={}{0:N0}개}" Style="{StaticResource BigNumber}"/>
     <TextBlock Text="부족 · 선택 수량 확인" Foreground="{StaticResource Amber}" FontSize="12" Visibility="{Binding IsShort, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>
   </DockPanel></Border>
  </UniformGrid>
  <StackPanel Grid.Row="1" Margin="0,10">
   <DockPanel>
   <TextBlock DockPanel.Dock="Right" Text="{Binding SupplyText}" Style="{StaticResource Caption}" Margin="12,0,0,0"/>
   <TextBlock Text="{Binding ModeNote}" Foreground="{StaticResource Blue}" FontSize="13" TextWrapping="Wrap"/>
   </DockPanel>
   <WrapPanel Margin="0,8,0,0" Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding IsIdle}">
    <TextBlock Text="연습용 A등급 추가" VerticalAlignment="Center" FontSize="13" Margin="0,0,10,0"/>
    <TextBox Text="{Binding DemoAddCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Width="84" MinHeight="32"/>
    <TextBlock Text="개" VerticalAlignment="Center" FontSize="13" Margin="6,0,10,0"/>
    <Button Content="연습 수량 추가" Command="{Binding AddDemoSupplyCommand}" Style="{StaticResource Btn.Small}"/>
    <TextBlock Text="1~10,000개 · 실제 재고에는 반영되지 않으며 재시작하면 초기화됩니다." VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Ink2}" Margin="12,0,0,0"/>
   </WrapPanel>
  </StackPanel>
  <Grid Grid.Row="2" IsEnabled="{Binding IsIdle}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="0"><DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="14,12,14,8">
     <WrapPanel>
      <Button Content="전체 선택 / 해제" Style="{StaticResource Btn.Small}" Command="{Binding SelectAllCommand}" Margin="0,0,8,6"/>
      <Button Content="출고 지시서" Style="{StaticResource Btn.Small}" Command="{Binding PrintInstructionCommand}" Margin="0,0,8,6"/>
      <Button Content="거래명세서" Style="{StaticResource Btn.Small}" Command="{Binding PrintStatementCommand}" Margin="0,0,0,6"/>
     </WrapPanel>
     <TextBlock Text="체크한 주문을 인쇄합니다. 체크가 없으면 오른쪽 상세 주문을 인쇄합니다." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
    </StackPanel>
    <TabControl BorderThickness="0" Background="Transparent" FontSize="14">
     <TabItem Header="출고 대기"><Grid>
      <ListBox ItemsSource="{Binding Pending}" Style="{StaticResource PlainList}" SelectionChanged="OnOrderSelectionChanged">
       <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" ToolTip="일괄 출고·인쇄 대상으로 선택"/>
        <StackPanel Grid.Column="1">
         <WrapPanel>
          <TextBlock Text="{Binding Order.No}" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" FontSize="14" Margin="0,0,10,4"/>
          <TextBlock Text="{Binding Order.Name}" FontSize="14" Margin="0,0,10,4"/>
          <TextBlock Text="{Binding Order.ReceivedAt, StringFormat={}{0:MM-dd HH:mm}}" Style="{StaticResource Caption}"/>
         </WrapPanel>
         <TextBlock Text="{Binding Order.ItemsSummary}" Foreground="{StaticResource Ink2}" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Order.ItemsSummary}"/>
         <WrapPanel Margin="0,4,0,0">
          <TextBlock Text="{Binding Courier}" Style="{StaticResource Caption}" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding Tracking}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,0,10,0"/>
          <TextBlock Text="{Binding Result}" Style="{StaticResource Caption}"/>
         </WrapPanel>
         <TextBlock Text="{Binding Checklist.StatusText}" FontSize="12" Margin="0,4,0,0">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Amber}"/>
           <Style.Triggers><DataTrigger Binding="{Binding Checklist.IsComplete}" Value="True"><Setter Property="Foreground" Value="{StaticResource Green}"/></DataTrigger></Style.Triggers>
          </Style></TextBlock.Style>
         </TextBlock>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Order.BatteryCount, StringFormat={}{0}개}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
       </Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="출고 대기 중인 주문이 없습니다" Foreground="{StaticResource Ink3}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Pending.IsEmpty, Converter={StaticResource BoolToVis}}"/>
     </Grid></TabItem>
     <TabItem Header="배송 중">
      <ListBox ItemsSource="{Binding OnTheWay}" Style="{StaticResource PlainList}" SelectionChanged="OnOrderSelectionChanged">
       <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,9">
        <TextBlock Text="{Binding Order.No}" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" FontSize="14"/>
        <TextBlock Text="{Binding Order.Name}" Margin="0,4,0,0"/>
        <TextBlock Foreground="{StaticResource Ink2}" Margin="0,4,0,0"><Run Text="{Binding Order.Courier, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Order.Tracking, Mode=OneWay}"/></TextBlock>
       </StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </TabItem>
    </TabControl>
   </DockPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}"><DockPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0"><StackPanel>
     <TextBlock Text="{Binding SelectedReadiness}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <TextBlock Text="{Binding SelectedChecklistText}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
     <UniformGrid Rows="1" Margin="0,0,0,12">
      <Button Content="{Binding InstructionButtonText}" ToolTip="체크한 주문 전체를 확인합니다. 체크가 없으면 현재 주문을 확인합니다." Style="{StaticResource Btn}" Command="{Binding ReviewSelectedCommand}" FontSize="13" Padding="6,0" MinHeight="40" Margin="0,0,6,0"/>
      <Button Content="이 주문 출고" Style="{StaticResource Btn.Primary}" Command="{Binding ShipCommand}" FontSize="13" Padding="6,0" MinHeight="40"/>
     </UniformGrid>
     <TextBlock Text="{Binding CheckedSummary}" FontWeight="Bold" FontSize="15"/>
     <TextBlock Text="{Binding CheckedReadiness}" TextWrapping="Wrap" Margin="0,6,0,10" FontSize="13">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink2}"/>
       <Style.Triggers><DataTrigger Binding="{Binding IsCheckedShort}" Value="True"><Setter Property="Foreground" Value="{StaticResource Red}"/></DataTrigger></Style.Triggers>
      </Style></TextBlock.Style>
     </TextBlock>
     <Button Content="선택 주문 일괄 출고" Style="{StaticResource Btn.Primary}" Command="{Binding ShipCheckedCommand}" MinHeight="44"/>
    </StackPanel></Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="주문별 출고 정보" Style="{StaticResource SectionTitle}"/>
    <TextBlock Text="왼쪽에서 주문을 선택하고 필요한 물량을 확인하세요." TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
    <StackPanel Visibility="{Binding Selected, Converter={StaticResource NullToCollapsed}}">
     <TextBlock Text="{Binding Selected.Order.No}" FontFamily="{StaticResource Mono}" FontSize="17" FontWeight="Bold"/>
     <TextBlock Text="{Binding Selected.Order.StatusText}" Foreground="{StaticResource Blue}" Margin="0,6,0,0"/>
     <TextBlock Text="{Binding Selected.Order.Name}" FontSize="14" Margin="0,10,0,0"/>
     <TextBlock Text="{Binding Selected.Order.Address}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
     <TextBlock Text="{Binding Selected.Order.Memo}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="IsEnabled" Value="False"/><Style.Triggers>
       <DataTrigger Binding="{Binding Selected.Order.Status}" Value="Inspect"><Setter Property="IsEnabled" Value="True"/></DataTrigger>
      </Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="택배사" Style="{StaticResource Caption}" Margin="0,18,0,6"/>
      <TextBlock Text="{Binding Selected.Courier}" FontWeight="SemiBold" FontSize="14"/>
      <TextBlock Text="송장번호" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
      <TextBox Style="{StaticResource Input}" Text="{Binding Selected.Tracking, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsDemo}" FontFamily="{StaticResource Mono}" FontSize="16"/>
      <TextBlock Text="{Binding TrackingNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <TextBlock Text="{Binding Selected.TrackingError}" Foreground="{StaticResource Red}" TextWrapping="Wrap" FontSize="13" Margin="0,6,0,0"/>
     </StackPanel>
    </StackPanel>
   </StackPanel></ScrollViewer></DockPanel></Border>
  </Grid>
  <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12,10"><StackPanel>
   <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold"/>
   <ProgressBar Height="4" IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
   <ItemsControl ItemsSource="{Binding Results}" Margin="0,4,0,0" MaxHeight="75">
    <ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template>
    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" Margin="0,2,0,0"/></DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </StackPanel></Border>
 </Grid>
</UserControl>
