<UserControl x:Class="BareunOrder.Feature.Certificate.CertificateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 담당: 유동호 — F6 검사 성적서 및 주문 관리 기간 보고서(일일/주간/월간) -->
    <UserControl.Resources>
        <Style x:Key="PeriodDateBox" TargetType="DatePicker">
            <Setter Property="Width" Value="130" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="SelectedDateFormat" Value="Short" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ 상단 기간 선택 바 (전체 날짜 선택 가능) ═══ -->
        <DockPanel Grid.Row="0" LastChildFill="False">
            <ListBox DockPanel.Dock="Left" Style="{StaticResource FilterBar}"
                     ItemsSource="{Binding PeriodOptions}"
                     SelectedItem="{Binding SelectedPeriodOption}"
                     DisplayMemberPath="Label" VerticalAlignment="Center" />

            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button Content="◀" Style="{StaticResource Btn.Small}" Command="{Binding PrevPeriodCommand}" ToolTip="이전 기간" />
                <DatePicker Style="{StaticResource PeriodDateBox}" Margin="8,0,0,0" ToolTip="시작일"
                            SelectedDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="~" VerticalAlignment="Center" Margin="6,0" Foreground="{StaticResource Ink2}" />
                <DatePicker Style="{StaticResource PeriodDateBox}" ToolTip="종료일 (그날 포함)"
                            SelectedDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="▶" Style="{StaticResource Btn.Small}" Command="{Binding NextPeriodCommand}" Margin="8,0,0,0" ToolTip="다음 기간" />
                <Button Content="오늘" Style="{StaticResource Btn.Small}" Command="{Binding SelectTodayPeriodCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="2" Text="{Binding PeriodSummaryText}" Style="{StaticResource Caption}" FontSize="13" />

        <!-- ═══ 본문: 좌측 출고된 주문 / 우측 성적서·보고서 탭 프리뷰 ═══ -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 출고된 주문 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,14,16,10" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitle}" VerticalAlignment="Center">
                            <Run Text="출고된 주문" /><Run Text="  " /><Run Text="{Binding Shipped.Count, Mode=OneWay}" Foreground="{StaticResource Ink3}" />
                        </TextBlock>
                        <CheckBox DockPanel.Dock="Right" Content="전체 기간" IsChecked="{Binding ShowAllShipped}"
                                  VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Ink2}"
                                  ToolTip="체크하면 기간과 관계없이 모든 출고 주문을 표시합니다" />
                    </DockPanel>
                    <Grid>
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Shipped}" SelectedItem="{Binding Selected}"
                                 BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="60">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding No}" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  ·  건전지 " /><Run Text="{Binding BatteryCount, Mode=OneWay}" /><Run Text="개" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border CornerRadius="3" Padding="7,3" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource GreenSoft}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CertNo}" Value="{x:Null}">
                                                                <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CertNo}" Value="">
                                                                <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="발급완료" />
                                                            <Setter Property="Foreground" Value="{StaticResource Green}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CertNo}" Value="{x:Null}">
                                                                    <Setter Property="Text" Value="미발급" />
                                                                    <Setter Property="Foreground" Value="{StaticResource Ink3}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding CertNo}" Value="">
                                                                    <Setter Property="Text" Value="미발급" />
                                                                    <Setter Property="Foreground" Value="{StaticResource Ink3}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusChip}"
                                                              VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="선택한 기간에 출고된 주문이 없습니다" Foreground="{StaticResource Ink3}" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Shipped.IsEmpty, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 오른쪽: 프리뷰 영역 (상단 [성적서] / [보고서] 탭) -->
            <Border Grid.Column="2" Background="#E4E7EC" CornerRadius="4">
                <DockPanel>
                    <!-- 프리뷰 상단 탭 바 -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                            BorderThickness="0,0,0,1" CornerRadius="4,4,0,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="성적서" Command="{Binding ShowCertificateTabCommand}" Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Btn.Small}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCertificateTab}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Blue}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Blue}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="보고서" Command="{Binding ShowReportTabCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Btn.Small}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReportTab}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Blue}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Blue}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 두 탭 모두 전체 폭을 채우도록 단일 Grid로 감쌈 -->
                    <Grid>
                        <!-- 탭 1: 성적서 프리뷰 (중앙 정렬) -->
                        <Grid Visibility="{Binding IsCertificateTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="왼쪽에서 주문을 고르면 성적서가 보입니다" Foreground="{StaticResource Ink3}" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Selected, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}" />

                            <DockPanel Visibility="{Binding Selected, Converter={StaticResource NullToCollapsed}}">
                                <Grid DockPanel.Dock="Top" Margin="20,14,20,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding StatusBannerText}" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Green}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWarningBanner}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="새로고침" Style="{StaticResource Btn}" Margin="0,0,8,0"
                                                Command="{Binding RefreshCommand}" />
                                        <Button Content="{Binding IssueButtonText}" Style="{StaticResource Btn.Primary}" Margin="0,0,8,0"
                                                Command="{Binding IssueCommand}" />
                                        <Button Content="CSV 저장" Style="{StaticResource Btn}" Margin="0,0,8,0"
                                                Command="{Binding ExportCsvCommand}" />
                                        <Button Content="인쇄 · PDF" Style="{StaticResource Btn}"
                                                Command="{Binding PrintCommand}" />
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                              HorizontalAlignment="Stretch">
                                    <Border Background="White" Width="640" Margin="20" Padding="40,36" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1" HorizontalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="건전지 출고 검사 성적서" FontSize="22" FontWeight="Bold" />
                                                    <TextBlock Text="바른전지 · AA 건전지 자동 검사 라인" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" BorderThickness="2" CornerRadius="3"
                                                        Padding="10,4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{StaticResource Green}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Data.AllPass}" Value="False">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource Red}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Data.VerdictText}" FontSize="18" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource Green}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Data.AllPass}" Value="False">
                                                                        <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>

                                            <Rectangle Height="2" Fill="{StaticResource Ink}" Margin="0,16,0,14" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="28" />
                                                    <RowDefinition Height="28" />
                                                    <RowDefinition Height="28" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="성적서 번호" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Data.CertNo}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="주문번호" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Selected.No}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Text="고객" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.Name}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="수량" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Data.Count, StringFormat={}{0}개}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="2" Text="검사 일시" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Data.InspectedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                           FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="검사 회차" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Data.RunId}" FontFamily="{StaticResource Mono}"
                                                           FontSize="12" VerticalAlignment="Center" />
                                            </Grid>

                                            <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,1" Margin="0,18,0,0">
                                                <StackPanel>
                                                    <Grid Background="{StaticResource SurfaceAlt}" Height="34">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="185" />
                                                            <ColumnDefinition Width="52" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="검사 항목" Style="{StaticResource ColHead}" Margin="10,0" />
                                                        <TextBlock Grid.Column="1" Text="기준" Style="{StaticResource ColHead}" />
                                                        <TextBlock Grid.Column="2" Text="결과" Style="{StaticResource ColHead}" />
                                                        <TextBlock Grid.Column="3" Text="판정" Style="{StaticResource ColHead}" />
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Data.Rows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                                                                    <Grid MinHeight="36">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="120" />
                                                                            <ColumnDefinition Width="185" />
                                                                            <ColumnDefinition Width="52" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Item}" Margin="10,6" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding Standard}" Foreground="{StaticResource Ink2}"
                                                                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,4,4,4" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding Result}" FontFamily="{StaticResource Mono}" FontSize="12"
                                                                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,4,4,4" />
                                                                        <TextBlock Grid.Column="3" FontWeight="Bold" VerticalAlignment="Center">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="적합" />
                                                                                    <Setter Property="Foreground" Value="{StaticResource Green}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Pass}" Value="False">
                                                                                            <Setter Property="Text" Value="부적합" />
                                                                                            <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Margin="0,16,0,0"
                                                        Visibility="{Binding Data.Runs.Count, Converter={StaticResource ZeroToCollapsed}}">
                                                <TextBlock Text="연결된 생산 회차 내역" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
                                                    <StackPanel>
                                                        <Grid Background="{StaticResource SurfaceAlt}" Height="28">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="145" />
                                                                <ColumnDefinition Width="55" />
                                                                <ColumnDefinition Width="50" />
                                                                <ColumnDefinition Width="75" />
                                                                <ColumnDefinition Width="75" />
                                                                <ColumnDefinition Width="75" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="회차 ID" Style="{StaticResource ColHead}" Margin="8,0" />
                                                            <TextBlock Grid.Column="1" Text="출하" Style="{StaticResource ColHead}" />
                                                            <TextBlock Grid.Column="2" Text="A등급" Style="{StaticResource ColHead}" />
                                                            <TextBlock Grid.Column="3" Text="무부하" Style="{StaticResource ColHead}" />
                                                            <TextBlock Grid.Column="4" Text="부하" Style="{StaticResource ColHead}" />
                                                            <TextBlock Grid.Column="5" Text="내부저항" Style="{StaticResource ColHead}" />
                                                            <TextBlock Grid.Column="6" Text="외관" Style="{StaticResource ColHead}" />
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{Binding Data.Runs}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                                                                        <Grid Height="28">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="145" />
                                                                                <ColumnDefinition Width="55" />
                                                                                <ColumnDefinition Width="50" />
                                                                                <ColumnDefinition Width="75" />
                                                                                <ColumnDefinition Width="75" />
                                                                                <ColumnDefinition Width="75" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding SourceRunId}" FontFamily="{StaticResource Mono}" FontSize="11" Margin="8,0" VerticalAlignment="Center" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding BatteryCount, StringFormat={}{0}개}" FontFamily="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center" />
                                                                            <TextBlock Grid.Column="2" Text="{Binding ACount, StringFormat={}{0}개}" FontFamily="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center" />
                                                                            <TextBlock Grid.Column="3" Text="{Binding VOpenText}" FontFamily="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center" />
                                                                            <TextBlock Grid.Column="4" Text="{Binding VLoadText}" FontFamily="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center" />
                                                                            <TextBlock Grid.Column="5" Text="{Binding RIntText}" FontFamily="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center" />
                                                                            <TextBlock Grid.Column="6" Text="{Binding VisualPassText}" FontFamily="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                                                       Text="{Binding Data.MissingNotice}"
                                                       Visibility="{Binding Data.MissingNotice, Converter={StaticResource NullToCollapsed}}" />

                                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                                                       Text="이 건전지는 YOLO 외관·극 방향 검사와 전압·내부저항 측정을 거쳐 A 등급으로 판정되었습니다." />
                                            <TextBlock Text="바른전지 품질관리" HorizontalAlignment="Right" FontWeight="SemiBold" Margin="0,24,0,0" />
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>

                        <!-- 탭 2: 보고서 프리뷰 (중앙 정렬 + 우측 열 잘림 방지) -->
                        <DockPanel Visibility="{Binding IsReportTab, Converter={StaticResource BoolToVis}}">
                            <DockPanel DockPanel.Dock="Top" Margin="20,14,20,8" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding ReportBundle.PeriodRangeText}"
                                           FontWeight="Bold" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="보고서 인쇄 · PDF" Style="{StaticResource Btn.Primary}"
                                        Command="{Binding PrintPeriodReportCommand}" />
                            </DockPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                          HorizontalAlignment="Stretch">
                                <Border Background="White" Width="760" Margin="20" Padding="12" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" HorizontalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" />
                                    </Border.Effect>
                                    <FlowDocumentScrollViewer x:Name="ReportPreviewViewer"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalScrollBarVisibility="Disabled"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              IsToolBarVisible="False" />
                                </Border>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>